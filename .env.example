# Required for live chat
OPENAI_API_KEY=
# Any OpenAI-compatible chat-completions model with tool calling; default below is a placeholder.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Required for web search
TAVILY_API_KEY=
# Optional alternative: Exa returns highlights and extracted text; auto prefers Exa when configured.
EXA_API_KEY=
SEARCH_PROVIDER=auto

# Optional settings
PORT=3000
TIMEZONE=Asia/Kolkata
DATABASE_PATH=./data/daymark.sqlite
MAX_TOOL_ROUNDS=3
MAX_SEARCH_RESULTS=5
